{
  "name": "sparkfare-app",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "triggers": {
    // "0 7 * * *" is the Workplan Step 93 early-access digest (EARLY_DIGEST_CRON in
    // src/index.js) -- must match that constant exactly or the two runs get misidentified.
    //
    // Step 117's weekly affiliate link health-check (WEEKLY_LINK_HEALTH_CRON in src/index.js,
    // "0 9 * * 1") is deliberately NOT added here yet -- this Cloudflare account is at the
    // Workers Free plan's account-wide cap of 5 cron triggers total (across every Worker in the
    // account, not just this one), discovered 2026-09-13 when adding a 3rd cron here failed with
    // "This account has reached the Workers Free limit of 5 cron triggers per account" and left
    // this Worker's trigger config partially updated. Reverted to the 2 known-good crons here to
    // protect the daily/early-bird digest sends while the capacity question (upgrade to Workers
    // Paid, or free up triggers on another Worker in the account) gets resolved. The health-check
    // function and its POST /api/check-affiliate-link-health endpoint both still work manually --
    // only automatic weekly scheduling is deferred.
    "crons": ["0 7 * * *", "0 8 * * *"]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/departing/*",
      "/go/*",
      "/index"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sparkfare-db",
      "database_id": "7228b5cb-54fd-4e4d-a7df-7e281f47bc8c"
    }
  ]
}