{
  "name": "sparkfare-app",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // "0 7 * * *" is the Workplan Step 93 early-access digest (EARLY_DIGEST_CRON in
    // src/index.js) -- must match that constant exactly or the two runs get misidentified.
    // "0 9 * * 1" is the Workplan Step 117 weekly affiliate link health-check (Monday 09:00 UTC,
    // WEEKLY_LINK_HEALTH_CRON in src/index.js) -- must also match that constant exactly. Re-added
    // 2026-09-13 after deleting the legacy "sparkfare" Worker (pre-rename leftover, confirmed
    // running duplicate current code against this same D1 database and holding 3 cron triggers of
    // its own), which had been the actual cause of the account's 5-cron-trigger Free-plan cap
    // blocking this 3rd cron -- see CLAUDE.md's incident writeup for the full story.
    "crons": ["0 7 * * *", "0 8 * * *", "0 9 * * 1"]
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/departing/*",
      "/go/*",
      "/index",
      "/kpi",
      "/hub",
      "/reward-terms",
      "/digest",
      "/digest/*",
      "/sitemap-digest.xml",
      "/sitemap-routes.xml"
    ]
  },
  "vars": {
    "ENABLE_T3_REFERRALS": "true",
    // Daily digest email v2 (content-rich template). Off: the original plain template is sent unchanged.
    "ENABLE_EMAIL_V2": "false",
    // Public web archive of the daily digest (/digest) and its daily archiving step. Off: the routes 404 and nothing is stored.
    "ENABLE_DIGEST_ARCHIVE": "false",
    "ENABLE_T7B_PUSH": "false",
    // T5b: self-serve display ad slots on route pages (AdSense or equivalent). Off until a
    // real ad-network publisher ID and slot ID replace the placeholder values in renderRoutePage.
    "ENABLE_T5B_ADS": "false",
    // Step 107/116: daily X (Twitter) posting, capped to one post/day. Stays off until the
    // X_API_KEY/X_API_SECRET/X_ACCESS_TOKEN/X_ACCESS_TOKEN_SECRET Worker secrets exist -- see
    // x_api_developer_application_draft.md for why (account + billing not set up yet).
    "ENABLE_X_BROADCASTER": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sparkfare-db",
      "database_id": "7228b5cb-54fd-4e4d-a7df-7e281f47bc8c"
    }
  ]
}