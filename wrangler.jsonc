{
  "name": "sparkfare-app",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // "0 9 * * 2" is the Workplan Step 117 weekly affiliate link health-check (Monday 09:00 UTC,
    // WEEKLY_LINK_HEALTH_CRON in src/index.js) -- must also match that constant exactly. Cloudflare numbers
    // days of the week 1 = Sunday, so Monday is 2; it was "0 9 * * 1" until 2026-10-13 and ran on Sundays. Re-added
    // 2026-09-13 after deleting the legacy "sparkfare" Worker (pre-rename leftover, confirmed
    // running duplicate current code against this same D1 database and holding 3 cron triggers of
    // its own), which had been the actual cause of the account's 5-cron-trigger Free-plan cap
    // blocking this 3rd cron -- see CLAUDE.md's incident writeup for the full story.
    // The "0 7 * * *" early-access digest was removed 2026-10-20 (owner decision): every subscriber is sent at the same time.
    // "30 3 * * *" asks GitHub to start the daily data pipeline (DAILY_FETCH_TRIGGER_CRON in src/index.js);
    // needs the GITHUB_DISPATCH_TOKEN Worker secret.
    "crons": ["30 3 * * *", "0 8 * * *", "30 9 * * *", "0 9 * * 2"]
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/departing/*",
      "/go/*",
      "/index",
      "/kpi",
      "/hub",
      "/reward-terms",
      "/check",
      "/pricing",
      "/leave",
      "/plan",
      "/home-card",
      "/card/*",
      "/passport",
      "/digest",
      "/digest/*",
      "/sitemap-digest.xml",
      "/time-off",
      "/time-off.ics",
      "/time-off/*",
      "/reports",
      "/reports/*",
      "/sitemap-routes.xml",
      "/og/*",
      "/how-it-works",
      "/how-it-works.html",
      "/llms.txt",
      "/c07b7b13e9a149c5950d24490f058097.txt"
    ]
  },
  "vars": {
    "ENABLE_T3_REFERRALS": "true",
    // Addendum M, M2: referral prompt on confirmation page, welcome email, and digest footer (names 3-referral watchlist tier).
    "ENABLE_REFERRAL_PROMPT": "true",
    // Addendum M, M3: /check share image and shareable result link (1200x630 card). Off: /og/check/* 404s and share button is hidden.
    "ENABLE_SHARE_IMAGE": "true",
    // Daily digest email v2 (content-rich template). Off: the original plain template is sent unchanged.
    "ENABLE_EMAIL_V2": "true",
    "ENABLE_EMAIL_CHECKLIST_V2": "true",
    // Public web archive of the daily digest (/digest) and its daily archiving step. Off: the routes 404 and nothing is stored.
    // Held until the SparkLoop gate is met (5 daily editions per origin plus the first weekly, due Mon Oct 12); see ROADMAP steps 21 and 24.
    "ENABLE_DIGEST_ARCHIVE": "true",
    // Private start for the archive (2026-10-07): store each day's editions while /digest still 404s and no email links to it.
    // Needs the digest_editions table (migration 0014, applied to production). Set ENABLE_DIGEST_ARCHIVE to "true" to publish them.
    "ENABLE_DIGEST_ARCHIVE_WRITE": "true",
    "ENABLE_T7B_PUSH": "false",
    // T5b: self-serve display ad slots on route pages (AdSense or equivalent). Off until a
    // real ad-network publisher ID and slot ID replace the placeholder values in renderRoutePage.
    "ENABLE_T5B_ADS": "false",
    // Step 107/116: daily X (Twitter) posting, capped to one post/day. Stays off until the
    // X_API_KEY/X_API_SECRET/X_ACCESS_TOKEN/X_ACCESS_TOKEN_SECRET Worker secrets exist -- see
    // x_api_developer_application_draft.md for why (account + billing not set up yet).
    "ENABLE_X_BROADCASTER": "false",
    // ROADMAP step 35: Pinterest OAuth connect + manual Pin creation (admin-only), built for the
    // Standard-access review demo. Off: /admin/pinterest/*, /pinterest/callback all 404 and
    // nothing else changes. Needs PINTEREST_APP_ID, PINTEREST_APP_SECRET, and
    // PINTEREST_TOKEN_ENCRYPTION_KEY Worker secrets (wrangler secret put) before turning on.
    // ROADMAP step 49: the /check "is this a good price?" page and /api/check. Off: both 404.
    // Turned on 2026-10-07.
    "ENABLE_PRICE_CHECK": "true",
    // ROADMAP step 22e: the /pricing Plus waitlist (double opt-in) and its /api/plus-waitlist routes. Off: all 404. Only the exact string "true" turns it on.
    // Turned on 2026-10-10 (owner). The page is noindex and nothing links to it yet; an address counts only once confirmed.
    "ENABLE_PLUS_WAITLIST": "true",
    // ROADMAP step 50 (lite): the homepage "Don't see your airport?" request link and /api/origin-request. Off: GET says
    // enabled:false (so the link stays hidden) and POST 404s. Only the exact string "true" turns it on.
    "ENABLE_ORIGIN_REQUESTS": "true",
    // Away Move 3 (ROADMAP step 55): the /leave Leave-ready page and /api/leave/plan. Off: both 404 and no links to it. Only the exact string "true" turns it on.
    "ENABLE_LEAVE_READY": "true",
    // Kill switch for the daily digest (07:00 early and 08:00 general runs, plus the sunset pruning in them). "false" stops it;
    // anything else, or unset, sends as normal. Flip and merge to apply.
    "ENABLE_DAILY_DIGEST": "true",
    "ENABLE_SUNDAY_NEWSLETTER": "false",
    // E3 skip-if-unchanged (ROADMAP step 21): when "true", a subscriber who already got a digest within the last 4 days is skipped on a day
    // when nothing is new or cheaper than what was last emailed for their origin. Only the exact string "true" turns it on. Off by default.
    "ENABLE_DIGEST_SKIP_UNCHANGED": "true",
    // Weekly owner email (ROADMAP step 65), sent by the Monday 09:00 UTC cron. Only the exact string "false" stops it.
    "ENABLE_WEEKLY_STANDUP": "true",
    // Away Move 2 (ROADMAP step 70): the one-tap trip self-report (/api/trip-status and the stress-valve email links). Off: 404 and no links.
    // Needs migration 0016 applied and UNSUBSCRIBE_SECRET set. Only the exact string "true" turns it on.
    "ENABLE_TRIP_SELF_REPORT": "false",
    // Away Mode pre-departure sequence (ROADMAP step 28): 14, 7, and 1 days before departure. Off: skips. Needs migration 0020.
    "ENABLE_T2B_SEQUENCE": "true",
    // PTO long-weekend planner (ROADMAP step 72): /time-off, /time-off/<origin>, its .ics and share card. Off: every path is 404.
    "ENABLE_PTO_CALENDAR": "true",
    // PTO window fares (ROADMAP step 73): shows the lowest fare seen for each long-weekend window. Needs ENABLE_PTO_CALENDAR. Off: windows say fares appear as we see them.
    // Turned on 2026-10-10 (#147), turned back off 2026-10-11 (owner): 36% of windows had a fare (56 of 800 calls priced), 0 for DFW, BOS, DEN and 7 more origins. Turn on again once coverage improves.
    "ENABLE_PTO_FARES": "false",
    // PTO window watches (ROADMAP step 74): lets visitors watch a long weekend and get email alerts when the fare drops. Needs migration 0019.
    "ENABLE_PTO_WATCH": "true",
    // PTO digest promo block (ROADMAP step 75): adds next long weekend line under deals in digests. Needs ENABLE_PTO_CALENDAR.
    "ENABLE_PTO_DIGEST_BLOCK": "false",
    // F0 (feat/f0-revenue-per-departure): record the revenue meter and trip-length bucket on outbound clicks and serve
    // GET /admin/meters (admin Bearer secret). Off: events are unchanged and the route 404s. Only the exact string "true" turns it on.
    "ENABLE_METER_TRACKING": "true",
    // F0 B3: send guest and signed-in homepage fare links, and Aviasales links in the daily digest and Sunday newsletter, through
    // /out/aviasales so each outbound click is logged with a surface. Adds one redirect hop. Only the exact string "true" turns it on.
    "ENABLE_FARE_ROUTING": "false",
    // G1 (feat/g1-long-leave): the 30_plus trip-length token on the signup forms and /account, and the three-item lead on /leave and
    // /away-mode for a 30_plus trip. Off: the site is unchanged, and a client that sends "30_plus" is stored as "2+ weeks". Only the exact string "true" turns it on.
    "ENABLE_LONG_LEAVE": "false",
    "ENABLE_PINTEREST": "true",
    "PINTEREST_ENV": "sandbox",
    // Leave-by plan (G23 / Addendum E): client-side and trip-attached leave-by checklist. Off: routes 404 and site unchanged. Only "true" turns it on.
    "ENABLE_LEAVE_BY_PLAN": "false",
    // Rule watcher (Addendum G, G2): weekly page-change check on the leave-by rules' official pages, held rules, /admin/rules.
    // Rides the existing Monday trigger. Off: nothing runs and /admin/rules returns 404. Only "true" turns it on.
    "ENABLE_RULE_WATCHER": "false",
    // Passport check (Addendum G, G5): the expiry-month check in the leave-by plan and the standalone /passport page. Off: /passport
    // and its status route return 404 and the plan has no passport fields. Only "true" turns it on.
    "ENABLE_PASSPORT_CHECK": "false",
    // Plan reminders (Addendum G, G7): the opt-in, the confirmation email, the due-date emails and the stop link. Needs ENABLE_LEAVE_BY_PLAN
    // too. Off: the routes return 404, nothing is stored, nothing is sent. Only "true" turns it on.
    "ENABLE_PLAN_REMINDERS": "false",
    // The Home card (Addendum G, G9): a private page for the person staying behind. Needs ENABLE_LEAVE_BY_PLAN.
    "ENABLE_HOME_CARD": "false",
    // Holiday Fare Report (Addendum M, M5): /reports/holiday-2026, /reports/holiday-2026.csv, /reports/holiday-2026-departures.csv. Off: all 404. Only "true" turns it on.
    "ENABLE_REPORTS": "false",
    // N5 (Addendum N): channel attribution and the daily landing counter. Switched on 2026-10-24 with the owner's approval (Hub Guard read)
    // and the approved privacy-page wording; it must stay in step with ENABLED in attribution.js (tests/n5_channel_attribution.test.js).
    "ENABLE_LANDING_COUNTER": "true",
    // N8 (Addendum N): the same-day data alert (09:30 UTC cron, DATA_ALERT_CRON in src/dataAlerts.js). When "true" the 08:00 health email stops repeating
    // data, backup and email-guard problems (they are reported by the 09:30 check, once a day, with limits and runbook links).
    "ENABLE_DATA_ALERTS": "true",
    "ENABLE_CURATED_SERVING": "false",
    "ENABLE_ROW_ALERT_CARD": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sparkfare-db",
      "database_id": "7228b5cb-54fd-4e4d-a7df-7e281f47bc8c"
    }
  ],
  // N2 (Addendum N): read-only use. The health check reads state/<pipeline>/latest.json (the validation gate's last result).
  // The raw fare archive itself is written only by GitHub Actions; this Worker never writes to it.
  "r2_buckets": [
    { "binding": "RAW", "bucket_name": "sparkfare-raw" }
  ]
}