node_modules/
.wrangler/
scratch/
# No trailing slash: matches .git whether it's the real directory (a normal
# checkout) or the one-line `gitdir: ...` pointer file (a git worktree) --
# `.git/` alone only matches a directory and silently misses the pointer-file
# case, which is how `wrangler deploy` from a worktree uploaded /.git publicly.
.git
.env
.env.*
.vscode/
.github/
*.lnk
__pycache__/
*.pyc

# Source code, tests, internal docs, and the task-tracker CSV are not meant to be public --
# `assets.directory` in wrangler.jsonc is the whole repo root, so anything not explicitly
# ignored here is served to anyone at sparkfare.com/<path>. Found live 2026-09-13: src/index.js,
# CLAUDE.md, and the full Master Workplan CSV (internal business/affiliate strategy) were all
# publicly reachable. sparkfare_*.json data files, *.html pages, and images stay unignored --
# they're genuinely public (fetched directly by the frontend) and some are also read
# server-side via env.ASSETS.fetch(), which needs them present in the uploaded asset bundle.
src/
tests/
.claude/
*.py
*.md
*.csv
package.json
package-lock.json
wrangler.jsonc
*.log

tmp/

# B9 (2026-09-25): migrate.sql and the numbered migration files (0002_partners.sql, etc. --
# see migrations_README.md) were reachable at sparkfare.com/migrate.sql and similar, exposing the
# full D1 schema (table/column names, FK relationships) to anyone. Same class of gap as the
# src/CLAUDE.md/CSV exposure found and fixed 2026-09-13 above -- nothing in this Worker ever
# fetches a .sql file at runtime (confirmed via grep for env.ASSETS.fetch), so there's no reason
# for these to be public assets at all.
*.sql
